# Copy this to .env and fill in your API keys
# cp .env.example .env

# The Odds API - get free key at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here
# Gate for Odds API fetches. Default false: the live-capture loop skips
# the consensus-divergence signal (#8) and avoids spamming failed HTTP
# calls when the free-tier quota is exhausted. Set to true once you have
# a paid tier and want consensus data back in the feature rows.
ENABLE_ODDS_API=false

# Kalshi API (optional) - https://docs.kalshi.com
KALSHI_API_KEY=
KALSHI_API_SECRET=

# Polymarket (optional) - public endpoints don't need auth
# POLYMARKET_API_KEY=
